{
  "name": "api",
  "version": "0.1.0",
  "author": {
    "name": "ImRayy",
    "url": "https://github.com/ImRayy"
  },
  "main": "index.ts",
  "packageManager": "bun@1.3.13",
  "dependencies": {
    "@hono/zod-openapi": "^1.1.3",
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.3.4",
    "drizzle-orm": "^0.43.1",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.7.9",
    "image-size": "^2.0.2",
    "imagekit": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "link-preview-js": "^3.1.0",
    "lodash.kebabcase": "^4.1.1",
    "meilisearch": "^0.54.0",
    "nanoid": "^5.1.5",
    "normalize-url": "^8.0.1",
    "pg": "^8.16.3",
    "resend": "^4.5.1",
    "tinycolor2": "^1.6.0",
    "tsuika-email-templates": "^0.0.4",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@faker-js/faker": "^10.1.0",
    "@hono/zod-validator": "^0.8.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/pg": "^8.15.6",
    "@types/tinycolor2": "^1.4.6",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.1",
    "drizzle-seed": "^0.3.1",
    "postgres": "^3.4.5"
  },
  "description": "Backend for tsuika build with 🔥, 🍞 and 🐘",
  "keywords": [
    "api",
    "backend",
    "hono",
    "postgres",
    "drizzle",
    "better-auth",
    "resend"
  ],
  "license": "AGPL-3.0",
  "private": true,
  "scripts": {
    "type-check": "tsc --noEmit",
    "start": "bun src/index.js",
    "dev": "NODE_ENV=development bun --hot src/index.ts",
    "build": "bun build src/index.ts --outdir ./dist --target bun",
    "serve": "bun run db:migrate && bun dist/index.js",
    "format": "biome format --write ./src",
    "lint": "biome check --write ./src",
    "lint:commit": "commitlint --edit",
    "db:migrate": "bun scripts/migrate.ts",
    "db:generate": "bun drizzle-kit generate --config=drizzle.config.ts",
    "build:container": "docker build -t tsuika-api ."
  },
  "type": "module"
}
