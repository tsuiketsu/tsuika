{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".output/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "env": [
        "DATABASE_URL",
        "DOMAIN",
        "FRONTEND_ORIGIN",
        "CORS_ORIGIN_HOPPSCOTCH",
        "CORS_ORIGIN_BROWSER_EXTENSION",
        "ENABLE_EMAIL_VERIFICATION",
        "RESEND_API_KEY",
        "JWT_SECRET",
        "MEILI_HOST",
        "MEILI_MASTER_KEY",
        "BETTER_AUTH_URL"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
