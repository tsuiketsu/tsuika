{
  "name": "tsuika",
  "devDependencies": {
    "@biomejs/biome": "2.1.2",
    "lefthook": "^2.1.9",
    "prettier": "^3.7.4",
    "turbo": "^2.9.16"
  },
  "peerDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "zod": "4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "zod": "^4.1.12",
    "kysely": "^0.28.17"
  },
  "packageManager": "bun@1.3.13",
  "private": true,
  "scripts": {
    "postinstall": "bun lefthook install",
    "build": "turbo run build",
    "dev": "bash ./scripts/run-compose.sh",
    "lint": "turbo run lint",
    "lint:commit": "commitlint --edit",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "dev:services": "docker compose -f docker-compose.dev.yml up -d",
    "dev:services:down": "docker compose -f docker-compose.dev.yml down",
    "prod:services": "docker compose up -d",
    "prod:services:down": "docker compose down"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "lefthook"
  ],
  "workspaces": [
    "apps/*"
  ]
}
