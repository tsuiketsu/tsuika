{
  "name": "tsuika",
  "devDependencies": {
    "lefthook": "^2.1.9",
    "prettier": "^3.7.4",
    "turbo": "^2.9.16"
  },
  "peerDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3",
    "zod": "4.1.12"
  },
  "overrides": {
    "zod": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.13",
  "private": true,
  "scripts": {
    "postinstall": "bun lefthook install",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "workspaces": [
    "apps/*"
  ]
}
