{
  "$schema": "https://biomejs.dev/schemas/2.1.2/schema.json",
  "vcs": {
    "enabled": false,
    "clientKind": "git",
    "useIgnoreFile": false
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "turbo.json",
      "**/apps/api/src/**/*",
      "**/apps/frontend/src/**/*",
      "**/apps/frontend/.vscode/**/*",
      "**/apps/frontend/index.html",
      "**/apps/frontend/vite.config.ts",
      "!**/apps/frontend/src/routeTree.gen.ts",
      "!**/apps/frontend/src/components/ui/**/*",
      "!**/apps/frontend/src/styles.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": { "useArrowFunction": "off", "useLiteralKeys": "off" },
      "suspicious": {
        "noExplicitAny": "warn",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["error"]
          }
        }
      },
      "correctness": {
        "noUnusedVariables": "warn"
      },
      "style": {
        "useConst": "warn",
        "noNonNullAssertion": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "indentStyle": "space",
      "indentWidth": 2
    }
  }
}
